# =============================================================================
# Qwen3.8-Flash-Next NVFP4 · SGLang TP2 on 2x DGX Spark — .env (ours, 2026-08-30)
# Copy to the MiaAI repo as .env and adapt CX IPs/IF/IB to YOUR wiring.
# =============================================================================

# ---- Cluster / networking (CX7 RoCE rail between the two Sparks) -----------
HEAD_CX7_IP=10.0.1.1
WORKER_CX7_IP=10.0.1.2
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f1

# ---- Worker SSH -------------------------------------------------------------
WORKER_USER=
WORKER_HOST=spark2

# ---- API / ports ------------------------------------------------------------
PORT=8888
API_KEY=
HOST_BIND=0.0.0.0
DIST_PORT=26400

# ---- Serving recipe (GB10 / SM121, 1M ctx) ---------------------------------
MEM_FRACTION_STATIC=0.82
CONTEXT_LENGTH=1048576
CHUNKED_PREFILL_SIZE=1024
MAX_RUNNING_REQUESTS=28
ALLOW_AUTO_TRUNCATE=0

# NEXTN speculative decoding (steps 4 impossible; 3/1/4 is max)
SPEC_STEPS=3
SPEC_TOPK=1
SPEC_DRAFT=4

# PLE n-gram table: empty = auto-rule (host offload; recommended on GB10)
PLE_OFFLOAD=

MAMBA_RADIX_CACHE_STRATEGY=extra_buffer
MAMBA_TRACK_INTERVAL=64
MAMBA_FULL_MEMORY_RATIO=

ENABLE_DECODE_GRAPHS=1
CUDA_GRAPH_BS=1 2 3 4 5 6 7 8 10 12 14 16

ATTENTION_BACKEND=flashinfer
# KV cache: 1 = NVFP4 KV (2.06M pool, ~10-17% slower decode); 0 = fp8_e4m3 (faster, 1.25M pool)
NVFP4_KV_CACHE=0
KV_CACHE_DTYPE=
FP4_GEMM_BACKEND=
LINEAR_ATTN_PREFILL_BACKEND=
LINEAR_ATTN_DECODE_BACKEND=

# ---- Model / image ----------------------------------------------------------
SERVED_MODEL_NAME=Qwen3.8-Flash-Next-NVFP4
KERNEL_PATCH=1
BASE_IMAGE=lmsysorg/sglang:qwen38flashnext
PATCHED_IMAGE=qwen38-flashnext-dspark:local

# ---- Ops ---------------------------------------------------------------------
DOWNLOAD_MODE=rsync
USE_HOST_NCCL=1
WAIT_TIMEOUT_MIN=90
NCCL_DEBUG=WARN
NCCL_CROSS_NIC=0
CPUSET=5-9,15-19
REASONING_PARSER=auto
TOOL_CALL_PARSER=auto

# ---- Caches / tokens --------------------------------------------------------
HF_REVISION=
HF_TOKEN=

# ---- Perf tuning (see docs/sglang-perf.md) ---------------------------------
EXTRA_ARGS=--speculative-attention-mode decode --enable-linear-replayssm-spec
NCCL_MAX_NCHANNELS=8
NCCL_MIN_NCHANNELS=8
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
TORCH_NCCL_ASYNC_ERROR_HANDLING=1
